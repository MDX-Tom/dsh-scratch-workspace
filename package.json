{
  "name": "dsh-scratch-workspace",
  "version": "0.1.2",
  "description": "DeepSeek Harness 瞬态会话隔离与草稿清理插件 — 顺应官方原生工作区规范的会话沙箱隔离、侧边栏归集与磁盘生命周期自动清理",
  "author": "Mi Tom <6468993+MDX-Tom@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MDX-Tom/dsh-scratch-workspace.git"
  },
  "homepage": "https://github.com/MDX-Tom/dsh-scratch-workspace#readme",
  "bugs": {
    "url": "https://github.com/MDX-Tom/dsh-scratch-workspace/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
